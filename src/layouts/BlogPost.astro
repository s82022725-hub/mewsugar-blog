---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, author, references } = Astro.props;

// Category Name Mapping
const categoryMap: Record<string, string> = {
	'health': '寵物健康',
	'pets-life': '毛孩生活',
	'reviews': '生活實用',
	'notes': '我的日常'
};
const categoryName = categoryMap[category as string] || '文章';
---

<html lang="zh-TW">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body class="bg-[#FDFBF7] text-[#4A5568] font-sans antialiased">
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-12">
			<article class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
				
				{/* Hero Image */}
				{heroImage && (
					<div class="w-full bg-gray-50 flex items-center justify-center border-b border-gray-100">
						<Image width={1200} height={800} src={heroImage} alt={title} class="w-full max-h-[600px] object-contain" />
					</div>
				)}

				<div class="p-8 md:p-12">
					{/* Meta Info */}
					<div class="flex flex-wrap items-center gap-4 text-sm font-medium text-gray-500 mb-6">
						{category && (
						<a href={`/category/${category}`} class="bg-[#F8F5F0] text-[#A67C52] px-3 py-1 rounded-full hover:bg-[#EAE4D9] transition-colors">
							{categoryName}
						</a>
						)}
						<div class="flex items-center gap-2">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
							{author || 'MewSugar'}
						</div>
						<div class="flex items-center gap-2">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
							<FormattedDate date={pubDate} />
						</div>
					</div>

					{/* Title */}
					<h1 class="text-3xl md:text-5xl font-bold text-gray-800 leading-tight mb-8 pb-8 border-b border-gray-100">{title}</h1>

					{/* Content */}
					<div class="prose prose-lg prose-[#A67C52] max-w-none 
						prose-headings:font-bold prose-headings:text-gray-800
						prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
						prose-p:text-gray-600 prose-p:leading-relaxed prose-p:mb-6
						prose-a:text-[#A67C52] prose-a:no-underline hover:prose-a:underline
						prose-img:rounded-2xl prose-img:shadow-sm prose-img:mx-auto
						prose-li:text-gray-600">
						<slot />
					</div>
					
					{/* References block */}
					{references && references.length > 0 && (
						<div class="mt-16 pt-8 border-t border-gray-100 bg-gray-50 rounded-2xl p-6 md:p-8">
							<h3 class="text-xl font-bold text-gray-700 flex items-center gap-2 mb-4">
								<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
								參考資料
							</h3>
							<ul class="space-y-2 text-sm text-gray-500">
								{references.map((ref) => (
									<li class="flex items-start gap-2">
										<span class="text-[#A67C52] mt-0.5">•</span>
										<a href={ref.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#A67C52] transition-colors underline underline-offset-4 decoration-gray-300 hover:decoration-[#A67C52]">
											{ref.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
