---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

export interface Props {
	title: string;
	description: string;
	updatedDate?: string;
}

const { title, description, updatedDate } = Astro.props;
---

<html lang="zh-TW">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body class="bg-[#FDFBF7] text-[#4A5568] font-sans antialiased min-h-screen flex flex-col">
		<Header />
		<main class="flex-grow max-w-3xl mx-auto px-4 py-16 w-full">
			<article class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100">
				<h1 class="text-3xl font-bold text-gray-800 mb-6">{title}</h1>
				
				<div class="prose prose-lg max-w-none prose-headings:text-gray-800 prose-a:text-[#A67C52] text-gray-600">
					<slot />
				</div>

				{updatedDate && (
					<div class="mt-12 pt-6 border-t border-gray-100 text-sm text-gray-400">
						最後更新日期：{updatedDate}
					</div>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
