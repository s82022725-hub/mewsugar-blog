---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import heroHome from '../assets/hero-home.jpg';

const posts = (await getCollection('blog'))
	.filter(post => !post.data.draft && post.data.pubDate <= new Date())
	.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#FDFBF7] text-[#4A5568] font-sans antialiased">
		<Header />
		<main>
			
			<section class="max-w-6xl mx-auto px-4 py-12 md:py-20 flex flex-col-reverse md:flex-row items-center gap-12">
				<div class="flex-1 text-center md:text-left">
					<h1 class="text-2xl md:text-4xl font-semibold text-[#A67C52] leading-snug mb-6 text-balance tracking-wide">
						記錄毛孩健康生活，<br/>分享生活裡的半糖好東西。
					</h1>
					<p class="text-base md:text-lg text-gray-500 mb-10 font-normal tracking-wide">
						半糖日常 - 毛孩健康與質感好物探索
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
						<a href="/category/health" class="bg-[#A67C52] text-white px-8 py-3 rounded-full font-bold hover:bg-[#8C6239] transition-colors shadow-md text-center whitespace-nowrap">
							探索寵物健康
						</a>
						<a href="/blog" class="bg-white text-[#A67C52] border-2 border-[#A67C52] px-8 py-3 rounded-full font-bold hover:bg-[#FDFBF7] transition-colors shadow-sm text-center whitespace-nowrap">
							所有文章
						</a>
					</div>
				</div>
				<div class="flex-1 w-full max-w-lg mx-auto md:max-w-none">
					<div class="aspect-[4/3] bg-gray-100 rounded-3xl overflow-hidden shadow-xl border-4 border-white">
						<Image src={heroHome} alt="可愛貓咪" class="w-full h-full object-cover object-top opacity-90" />
					</div>
				</div>
			</section>

			<section class="bg-white py-16 md:py-24">
				<div class="max-w-6xl mx-auto px-4">
					<div class="text-center mb-12">
						<h2 class="text-xl md:text-2xl font-semibold text-[#A67C52] mb-4 tracking-wide">最新核心指南</h2>
						<p class="text-gray-500">從測量、判讀到日常照護的專業資訊整理，飼主的無壓力筆記。</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-10">
					{
						latestPosts.map((post) => (
							<a href={`/blog/${post.id}/`} class="group flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 hover:-translate-y-1">
								<div class="aspect-[4/3] bg-gray-100 overflow-hidden relative">
									{post.data.heroImage ? (
										<Image width={600} height={450} src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
									) : (
										<div class="w-full h-full flex items-center justify-center text-gray-400">無圖片</div>
									)}
								</div>
								<div class="p-6 flex flex-col flex-grow">
									{post.data.category && (
										<span class="text-xs font-bold text-[#7E9883] uppercase tracking-wider mb-2">{post.data.category}</span>
									)}
									<h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-[#A67C52] transition-colors line-clamp-2">{post.data.title}</h3>
									<p class="text-gray-500 text-sm mb-4 line-clamp-3">{post.data.description}</p>
									<div class="mt-auto text-xs text-gray-400 font-medium pt-4 border-t border-gray-50">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</div>
							</a>
						))
					}
					</div>

					<div class="text-center">
						<a href="/blog" class="inline-flex items-center gap-2 text-[#A67C52] font-bold hover:text-[#8C6239] transition-colors">
							查看所有文章 <span>&rarr;</span>
						</a>
					</div>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>
